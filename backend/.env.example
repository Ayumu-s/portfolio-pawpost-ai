# Defaults selected when the UI does not override them
IMAGE_AI_PROVIDER=mock
TEXT_AI_PROVIDER=mock

# Browser origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:3000
# For a phone on the same LAN, add its browser origin, e.g.
# FRONTEND_ORIGIN=http://localhost:3000,http://your-lan-host:3000
MAX_IMAGE_SIZE_MB=15

# Local media MVP limits: multi-image is up to 10 images; video is one file,
# up to 100MB, sampled into at most 12 representative frames. Audio is not read.
